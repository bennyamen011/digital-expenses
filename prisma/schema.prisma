// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  is_first  Boolean  @default(false)
  salary    Float    @default(0)
  createdAt DateTime @default(now())
}

model Expense {
  id       String   @id @default(uuid())
  name     String
  amount   Float
  category String
  date     DateTime
  userId   String
}

model Saving {
  id               String   @id @default(uuid())
  name             String @default("")
  amount           Float
  totalsavedAmount Float   
  date             DateTime
  duration         Float    @default(0)
  frequency        String   @default("")
  totalAmount      Float
  createdAt        DateTime @default(now())
  savedList        Saved[]  @relation("SavingToSaved")
}

model Saved {
  id        String   @id @default(uuid())
  savingId  String
  name      String
  amount    Float
  date      DateTime
  status    String  @default("pending") // "saved" or "pending"

  saving    Saving  @relation("SavingToSaved", fields: [savingId], references: [id])
}
